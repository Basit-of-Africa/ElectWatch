rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives & Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ajibadebasit40@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'email', 'displayName', 'createdAt']) &&
             data.keys().size() <= 20 && // Allow checkIn fields, assigned polling unit, phone, status, etc.
             data.uid is string && data.uid.size() <= 128 &&
             data.role in ['admin', 'supervisor', 'observer'] &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['pollingUnitId', 'observerId', 'timestamp', 'type', 'payload']) &&
             data.keys().size() <= 12 && // Allow location, media, updatedAt, etc.
             isValidId(data.pollingUnitId) &&
             data.observerId == request.auth.uid &&
             data.type in ['accreditation', 'incident', 'result'] &&
             data.payload is map;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['updatedBy', 'timestamp', 'changes']) &&
             data.keys().size() <= 8;
    }

    function isValidIncident(data) {
      return data.keys().hasAll(['reportId', 'pollingUnitId', 'severity', 'status', 'description', 'timestamp']) &&
             data.keys().size() <= 8 &&
             isValidId(data.reportId) &&
             isValidId(data.pollingUnitId) &&
             data.severity in ['low', 'medium', 'high', 'critical'] &&
             data.status in ['pending', 'investigating', 'resolved'] &&
             data.description is string && data.description.size() <= 5000;
    }

    function isValidIncidentHistory(data) {
      return data.keys().hasAll(['status', 'updatedBy', 'timestamp']) &&
             data.keys().size() <= 8;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'timestamp']) &&
             data.keys().size() <= 8 && // Allow link
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ['info', 'warning', 'error', 'success'] &&
             data.read is bool;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if (isOwner(userId) && isValidUser(incoming())) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
    }

    match /checkins/{checkInId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /polling_units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidReport(incoming());
      allow update, delete: if isAdmin();

      match /audit_logs/{logId} {
        allow read: if isSignedIn();
        allow create: if isAdmin() && isValidAuditLog(incoming());
      }
    }

    match /incidents/{incidentId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && isValidIncident(incoming());
      allow update: if (isAdmin() || isSupervisor()) && isSignedIn();
      allow delete: if isAdmin();

      match /history/{historyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidIncidentHistory(incoming());
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
