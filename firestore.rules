rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives & Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ajibadebasit40@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Admin check for LIST operations (avoiding get() to follow strict cost-optimization)
    function isAdminList() {
      return isSignedIn() && request.auth.token.email == 'ajibadebasit40@gmail.com';
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isObserver() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'observer';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'email', 'displayName', 'createdAt']) &&
             data.keys().size() <= 6 && // Allow assignedPollingUnitId
             data.uid == request.auth.uid &&
             data.role in ['admin', 'supervisor', 'observer'] &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['pollingUnitId', 'observerId', 'timestamp', 'type', 'payload']) &&
             data.keys().size() <= 6 && // Allow location if present
             isValidId(data.pollingUnitId) &&
             data.observerId == request.auth.uid &&
             data.type in ['accreditation', 'incident', 'result'] &&
             data.payload is map;
    }

    function isValidIncident(data) {
      return data.keys().hasAll(['reportId', 'pollingUnitId', 'severity', 'status', 'description', 'timestamp']) &&
             data.keys().size() == 6 &&
             isValidId(data.reportId) &&
             isValidId(data.pollingUnitId) &&
             data.severity in ['low', 'medium', 'high', 'critical'] &&
             data.status in ['pending', 'investigating', 'resolved'] &&
             data.description is string && data.description.size() <= 5000;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'timestamp']) &&
             data.keys().size() <= 7 && // Allow link
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ['info', 'warning', 'error', 'success'] &&
             data.read is bool;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); // Switched to isAdmin() which uses get() because list is only /users/
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isAdmin() || (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'assignedPollingUnitId']))) && 
                    isValidUser(incoming());
      allow update: if isAdmin(); // Admin can change everything
    }

    match /polling_units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      // Observers list their own, Admins & Supervisors list all
      allow list: if isAdmin() || isSupervisor() || (isSignedIn() && resource.data.observerId == request.auth.uid);
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidReport(incoming()) && incoming().timestamp == request.time;
      allow update, delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      // Incidents are public to all authenticated users for transparency
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && isValidIncident(incoming()) && incoming().timestamp == request.time;
      allow update: if isAdmin() && incoming().timestamp == request.time;
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      // List query must prove it only returns what user can see.
      // NotificationCenter queries 'userId' in [uid, 'supervisor', 'admin'].
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.userId == 'admin' && isAdmin()) ||
        (resource.data.userId == 'supervisor' && (isSupervisor() || isAdmin()))
      );
      
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.userId == 'admin' && isAdmin()) ||
        (resource.data.userId == 'supervisor' && (isSupervisor() || isAdmin()))
      );
      
      allow create: if isSignedIn() && isValidNotification(incoming()) && incoming().timestamp == request.time;
      allow update: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }
  }
}
