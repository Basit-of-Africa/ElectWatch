{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a system user, either an admin or a field observer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "supervisor", "observer"] },
        "assignedPollingUnitId": { "type": "string", "description": "The ID of the polling unit assigned to this observer." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    },
    "PollingUnit": {
      "title": "Polling Unit",
      "description": "A specific location where voting takes place.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "state": { "type": "string" },
        "lga": { "type": "string" },
        "ward": { "type": "string" },
        "totalRegisteredVoters": { "type": "integer" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      },
      "required": ["id", "name", "state", "lga", "ward"]
    },
    "Report": {
      "title": "Report",
      "description": "A data point submitted by an observer from a polling unit.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pollingUnitId": { "type": "string" },
        "observerId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["accreditation", "incident", "result"] },
        "payload": { "type": "object" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "media": {
          "type": "array",
          "description": "List of evidence-grade media attachments (photos/video hashes).",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "type": { "type": "string" },
              "hash": { "type": "string", "description": "SHA-256 hash for integrity verification." }
            }
          }
        }
      },
      "required": ["id", "pollingUnitId", "observerId", "timestamp", "type", "payload"]
    },
    "Incident": {
      "title": "Incident",
      "description": "A specific security or procedural issue flagged at a polling unit.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reportId": { "type": "string" },
        "pollingUnitId": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["pending", "investigating", "resolved"] },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reportId", "pollingUnitId", "severity", "status", "description", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A system alert for a user or role.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "error", "success"] },
        "read": { "type": "boolean" },
        "link": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "read", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/polling_units/{unitId}": {
      "schema": "PollingUnit",
      "description": "Master list of polling units."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Stream of incoming observation reports."
    },
    "/incidents/{incidentId}": {
      "schema": "Incident",
      "description": "Tracked incidents needing attention."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System alerts and notifications."
    }
  }
}
